APP_ENV=development
APP_NAME=MiniCloud
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8001
FRONTEND_URL=http://localhost:3001

# Replace every placeholder before starting the stack. Keep each value unique.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-unique-postgres-admin-password
MINICLOUD_API_DATABASE_URL=postgresql+psycopg://minicloud_api_runtime:replace-with-a-unique-api-password@postgres:5432/minicloud
MINICLOUD_WORKER_DATABASE_URL=postgresql+psycopg://minicloud_worker_runtime:replace-with-a-unique-worker-password@postgres:5432/minicloud
MINICLOUD_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-unique-migration-password@postgres:5432/minicloud
DATABASE_URL=postgresql+psycopg://minicloud_api_runtime:replace-with-a-unique-api-password@127.0.0.1:5433/minicloud
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-unique-migration-password@127.0.0.1:5433/minicloud

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3001
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
WORKER_INTERVAL_SECONDS=10
KUBERNETES_IN_CLUSTER=false
KUBERNETES_NAMESPACE=minicloud
KUBERNETES_ROLLOUT_TIMEOUT_SECONDS=600
# Diagnostics use a separate read-only identity; leave disabled unless assigned
# to the API's dedicated ServiceAccount or an explicit local test context.
KUBERNETES_DIAGNOSTICS_IN_CLUSTER=false
KUBERNETES_DIAGNOSTICS_CONFIG_FILE=
KUBERNETES_DIAGNOSTICS_CONTEXT=
MINICLOUD_WORKER_CREDENTIAL_DIR=./.local/worker-credentials
KIND_DOCKER_NETWORK=kind
ENABLE_METRICS=false
